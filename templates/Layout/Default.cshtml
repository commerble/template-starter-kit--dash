<!DOCTYPE html>
<html lang="ja">
<head prefix="og: http://ogp.me/ns# fb: http://ogp.me/ns/fb# article: http://ogp.me/ns/article#">
    @RenderMeta()
    <link rel="stylesheet" href="@Resolve("/bundle/style.css" + ViewBag.ResourceSuffix)">
    @RenderParts("Head")
    @RenderJsonLD()
    @RenderDataLayer()
    @RenderSection("StyleBlock", false)
    @*
    <style>
        @@view-transition {
            navigation: auto;
        }
        @if (ViewBag.Transitions is List<string> transitions) {
            foreach (var name in transitions) {
                <text>
                .@name {
                    view-transition-name: @name;
                    contain: paint;
                }
                </text>
            }
        }
    </style>
    *@
</head>

<body>
    @RenderParts("BodyTop")
    @RenderHeaderBanner()
    <div class="sticky-header">
        @RenderHeader()
        @RenderGlobalNav()
    </div>
    @RenderBody()
    @RenderFooter()
    @RenderPreviewFooter()
    @*@Page.Template.MiniProfilerRenderIncludes()*@
    <script src="@Resolve("/bundle/script.js" + ViewBag.ResourceSuffix)"></script>
    @RenderSection("ScriptBlock", false)
    @RenderParts("BodyBottom")
</body>
</html>